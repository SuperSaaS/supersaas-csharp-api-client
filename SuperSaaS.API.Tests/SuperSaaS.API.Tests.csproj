<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SuperSaaS.API.Tests</AssemblyName>
    <RootNamespace>SuperSaaS.API.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.4.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperSaaS.API.Client\SuperSaaS.API.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PublicApi.approved.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
